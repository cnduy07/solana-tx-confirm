{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "module": "node16",
        "moduleResolution": "node16",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"]
}
